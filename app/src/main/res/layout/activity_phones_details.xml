<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    tools:context=".ProductDetailsScreenActivity">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Boost Pesa Phones and Others"
        app:titleTextAppearance="@style/textAppearanceTitleBold"
        android:background="@color/colorPrimary"
        app:titleTextColor="@color/white"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:elevation="4dp"
     />
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/samsun_device"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Samsung A3 Core"
        android:id="@+id/txtPhoneName"
        android:layout_marginTop="10dp"
        android:textColor="@android:color/black"
        android:textAppearance="@style/textAppearanceTitleBold"
        />
    <LinearLayout
        android:layout_marginTop="20dp"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price deposit 4,000 /= daily 60/="
            android:textAppearance="@style/textAppearanceBody"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Features"
            android:textSize="16sp"
            android:layout_marginTop="10dp"
          android:textAppearance="@style/textAppearanceTitleBold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:text="Screen : 6.5 inches 720 x 1480 pixels"
            android:textAppearance="@style/textAppearanceBody"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Colors: Blue, Black, Red"

            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:textAppearance="@style/textAppearanceBody"
        />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Font Camera: 5MP"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:textAppearance="@style/textAppearanceBody"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OS: Android 11; Go Edition"
         android:textAppearance="@style/textAppearanceBody" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPU: 1.5GHz, Quad-core"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:textAppearance="@style/textAppearanceBody"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAM: 2GB"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:textAppearance="@style/textAppearanceBody"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Storage: 32GB"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:textAppearance="@style/textAppearanceBody"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery: 5000mAh, Li-Ion"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:textAppearance="@style/textAppearanceBody"/>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Proceed"
        app:cornerRadius="10dp"
        app:backgroundTint="@color/colorPrimary"
        android:layout_marginBottom="15dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:id="@+id/btnProceed"
        android:textColor="@color/white"/>
</LinearLayout>